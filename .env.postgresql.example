# Configuración de PostgreSQL para Laravel
# Copia este archivo a .env.postgresql y actualiza con tus valores

# Conexión PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tu_base_de_datos
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña

# Configuración adicional para PostgreSQL
# DB_SCHEMA=public
# DB_SSLMODE=prefer

# Mantener otras configuraciones del .env original
# APP_NAME, APP_KEY, APP_DEBUG, etc.